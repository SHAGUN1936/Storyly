{
  "name": "storyly",
  "version": "2.0.0",
  "private": true,
  "description": "Storyly: cinematic invitations, story pages and personalized videos made from templates",
  "scripts": {
    "dev": "prisma generate && next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^9.14.1",
    "jose": "^6.2.14",
    "lenis": "^1.3.27",
    "lucide-react": "^1.17.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.6",
    "next": "15.5.28",
    "node-html-parser": "^9.0.6",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
