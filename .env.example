# Copy this file to .env and fill in the values.

# MongoDB connection string (Atlas or a local replica set). Include the database name.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/personalized-videos?retryWrites=true&w=majority"

# Random secret that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Google sign-in (OAuth client id from Google Cloud console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Cloudinary (photo/video uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: public site URL used in share links and QR codes (defaults to the request's own address)
# NEXT_PUBLIC_SITE_URL="https://storyly.example.com"

# Optional: full path to ffmpeg if the bundled one does not work (only needed for video templates)
# FFMPEG_PATH="C:\ffmpeg\bin\ffmpeg.exe"

# Used by `npm run db:seed` to create/update the admin login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
