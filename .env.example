# The ONE environment file for the whole app (website, API, admin and editor all run in this Next.js app).
#
#   Local:   copy this file to .env and fill in the values.
#   Deploy:  add the same keys in your host's settings (Vercel → Project → Settings → Environment Variables).
#            There is no separate server to deploy.
#
# Never commit .env. Values starting with NEXT_PUBLIC_ are visible in the browser; everything else stays on the server.

# ---------- Required ----------

# MongoDB connection string (Atlas). Put the database name before the "?".
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/personalized-videos?retryWrites=true&w=majority"

# Long random secret that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Cloudinary: photo/video uploads and imported-site images
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Optional ----------

# Google sign-in: OAuth client id from Google Cloud Console.
# Add every address the site runs on under "Authorized JavaScript origins"
# (e.g. http://localhost:3001 and https://your-domain.com).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Public address of the site, used in share links and QR codes. Set it in production.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# AI help when importing templates (Admin → Templates → New template). Without it, imports still work.
# ANTHROPIC_API_KEY=""

# Full path to ffmpeg, only if the bundled one does not work (video templates).
# FFMPEG_PATH="C:\ffmpeg\bin\ffmpeg.exe"
